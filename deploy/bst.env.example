# Install this file as /etc/bst/env, owned root:root with mode 0600.
# systemd reads it as root before dropping to the bst user.

# Required: the bot token.
SLACK_BOT_TOKEN=
# Required: the app-level token for Socket Mode.
SLACK_APP_TOKEN=
# Required: the id of the one channel the bot watches.
SLACK_CHANNEL_ID=
# Optional: a link for the word "rules" in replies.
BST_RULES_URL=
