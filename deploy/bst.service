[Unit]
Description=Slack bot that replies to listing posts breaking the posting format
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bst
Group=bst
WorkingDirectory=/opt/bst/app
# Set the node path to the output of `command -v node`.
ExecStart=/usr/bin/node /opt/bst/app/src/app.js
Restart=on-failure
RestartSec=5

# Secrets come from this root-owned file only. There is no Environment= line,
# because systemd shows those values to every local user over D-Bus.
EnvironmentFile=/etc/bst/env

# Sandbox. The code tree is owned by root and ProtectSystem=strict keeps it
# read-only to the service. There is no ReadWritePaths, because the bot writes
# nothing to disk. There is no MemoryDenyWriteExecute, because Node's JIT needs
# writable executable memory.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M

[Install]
WantedBy=multi-user.target
